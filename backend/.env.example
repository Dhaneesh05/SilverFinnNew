# Silver Finn Backend — Environment Variables
# Copy this to .env and fill in your values

# ── Database ──────────────────────────────────────────────────────────
# Get a free Neon PostgreSQL DB at: https://neon.tech
DATABASE_URL="postgresql://user:password@host/silverfinn?sslmode=require"

# ── JWT ───────────────────────────────────────────────────────────────
JWT_SECRET="silverfinn-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# ── Server ────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── Cloudinary (Photo uploads — free tier) ────────────────────────────
# Get free account at: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Z.ai GLM (RAG Chat) ───────────────────────────────────────────────
# Get API key at: https://z.ai or https://open.bigmodel.cn
ZHIPUAI_API_KEY=your_zhipuai_api_key

# ── ChromaDB ──────────────────────────────────────────────────────────
CHROMA_HOST=http://localhost:8000
CHROMA_COLLECTION=silverfinn_knowledge
